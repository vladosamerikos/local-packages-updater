{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Actualizaciones",
  "version": "0.4.0",
  "identifier": "es.vlad.actualizaciones",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Actualizador de Codex Desktop y Spotifast",
    "longDescription": "Comprueba e instala actualizaciones de Codex Desktop y Spotifast en Ubuntu.",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": {
      "resources/apps/": "apps/"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/actualizaciones.desktop",
        "depends": [
          "curl",
          "flatpak",
          "gpgv",
          "liblzma5",
          "libgtk-3-0t64",
          "libwebkit2gtk-4.1-0",
          "pkexec"
        ]
      }
    }
  }
}
